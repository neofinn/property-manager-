# Copy to .env (never commit .env). `npm start` reads it automatically.

# Supabase: Project → Connect → "Session pooler" connection string (port 5432).
# Leave empty to store data in SQLite files under DATA_DIR instead.
DATABASE_URL=

# Turns on the developer admin area at /admin.
ADMIN_PASSWORD=

# Optional: require this code to sign up (can also be set in /admin → Controls).
BETA_INVITE_CODE=

PORT=3000
HOST=127.0.0.1
CURRENCY=INR
DEFAULT_COUNTRY_CODE=91
